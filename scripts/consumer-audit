#!/usr/bin/env node
const { audit, inspect } = require('../packages/sitekit-cli/lib/audit.cjs');
if (require.main === module) {
  try {
    const args = process.argv.slice(2);
    if (args.length < 1 || args.length > 2) throw new Error('Usage: node scripts/consumer-audit INSTALLED_DIST [CANDIDATE_DIST]');
    const result = audit(...args);
    console.log(JSON.stringify(result, null, 2));
    if (!result.installed.valid || (result.candidate && !result.candidate.valid)) process.exitCode = 1;
  } catch (error) { console.error(error.message); process.exitCode = 1; }
}
module.exports = { audit, inspect };
