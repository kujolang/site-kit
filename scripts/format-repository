#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const root = path.resolve(__dirname, '..');
const check = process.argv.includes('--check');
const supported = new Set(['.css', '.html', '.js', '.json', '.md', '.mjs', '.toml', '.yaml', '.yml']);
const excluded = new Set(['.git', '.lens', '.workcell', 'artifacts', 'node_modules', 'playwright-report', 'test-results']);

function walk(directory = root) {
  return fs.readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    if (excluded.has(entry.name)) return [];
    const absolute = path.join(directory, entry.name);
    if (entry.isDirectory()) return walk(absolute);
    return entry.isFile() ? [path.relative(root, absolute)] : [];
  });
}

function repositoryFiles() {
  try {
    return execFileSync('git', ['ls-files', '-z'], { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
      .split('\0')
      .filter(Boolean);
  } catch {
    return walk().sort();
  }
}

const files = repositoryFiles()
  .filter((file) => supported.has(path.extname(file)) || file.startsWith('scripts/'));
const changed = [];

for (const file of files) {
  const absolute = path.join(root, file);
  if (!fs.existsSync(absolute) || fs.statSync(absolute).isDirectory()) continue;
  const original = fs.readFileSync(absolute, 'utf8');
  let formatted = original.replace(/\r\n?/g, '\n').replace(/[ \t]+$/gm, '').replace(/\n*$/, '\n');
  if (path.extname(file) === '.json') {
    formatted = `${JSON.stringify(JSON.parse(formatted), null, 2)}\n`;
  }
  if (formatted === original) continue;
  changed.push(file);
  if (!check) fs.writeFileSync(absolute, formatted);
}

if (changed.length && check) {
  console.error(`format check failed (${changed.length} files):\n${changed.join('\n')}`);
  process.exit(1);
}

console.log(check ? `format check passed: ${files.length} files` : `formatted ${changed.length} of ${files.length} files`);
