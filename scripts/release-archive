#!/usr/bin/env node
'use strict';

const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const zlib = require('zlib');

const root = path.resolve(__dirname, '..');
const pkg = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8'));
const releaseRoot = `sitekit-v${pkg.version}`;
const outputDir = path.join(root, 'artifacts', 'release');
const archivePath = path.join(outputDir, `${releaseRoot}.tar.gz`);
const checksumPath = `${archivePath}.sha256`;
const payload = [
  'LICENSE',
  'dist/LICENSE',
  'dist/README.md',
  'dist/sitekit-manifest.json',
  'dist/sitekit.css',
  'dist/sitekit.js',
  'dist/fonts/DepartureMono-LICENSE.txt',
  'dist/fonts/DepartureMono-Regular.woff',
  'dist/fonts/DepartureMono-Regular.woff2',
];
const sha256 = (data) => crypto.createHash('sha256').update(data).digest('hex');

function writeOctal(buffer, offset, length, value) {
  const encoded = value.toString(8).padStart(length - 1, '0').slice(-(length - 1));
  buffer.write(`${encoded}\0`, offset, length, 'ascii');
}

function header(name, size, mode = 0o644) {
  if (Buffer.byteLength(name) > 100) throw new Error(`tar path exceeds 100 bytes: ${name}`);
  const block = Buffer.alloc(512, 0);
  block.write(name, 0, 100, 'utf8');
  writeOctal(block, 100, 8, mode);
  writeOctal(block, 108, 8, 0);
  writeOctal(block, 116, 8, 0);
  writeOctal(block, 124, 12, size);
  writeOctal(block, 136, 12, 0);
  block.fill(0x20, 148, 156);
  block.write('0', 156, 1, 'ascii');
  block.write('ustar\0', 257, 6, 'ascii');
  block.write('00', 263, 2, 'ascii');
  block.write('root', 265, 32, 'ascii');
  block.write('root', 297, 32, 'ascii');
  writeOctal(block, 148, 8, block.reduce((sum, byte) => sum + byte, 0));
  return block;
}

function entry(name, data) {
  const padding = Buffer.alloc((512 - (data.length % 512)) % 512, 0);
  return Buffer.concat([header(name, data.length), data, padding]);
}

for (const file of payload) {
  if (!fs.existsSync(path.join(root, file))) throw new Error(`release payload missing: ${file}; run npm run build`);
}

const releaseManifest = {
  schemaVersion: 1,
  product: 'SiteKit',
  version: pkg.version,
  distribution: 'source-vendored',
  files: Object.fromEntries(payload.map((file) => [file, sha256(fs.readFileSync(path.join(root, file)))])),
};
const manifestData = Buffer.from(`${JSON.stringify(releaseManifest, null, 2)}\n`);
const tar = Buffer.concat([
  ...payload.map((file) => entry(`${releaseRoot}/${file}`, fs.readFileSync(path.join(root, file)))),
  entry(`${releaseRoot}/release-manifest.json`, manifestData),
  Buffer.alloc(1024, 0),
]);
const archive = zlib.gzipSync(tar, { level: 9, mtime: 0 });
fs.mkdirSync(outputDir, { recursive: true });
fs.writeFileSync(archivePath, archive);
fs.writeFileSync(checksumPath, `${sha256(archive)}  ${path.basename(archivePath)}\n`);
console.log(JSON.stringify({ archive: path.relative(root, archivePath), checksum: sha256(archive), files: payload.length + 1 }));
