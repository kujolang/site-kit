#!/usr/bin/env node
'use strict';

const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const root = path.resolve(__dirname, '..');
const outputs = [
  'css/generated',
  'DESIGN.md',
  'docs/components.md',
  'examples/component-lab/contracts.js',
  'docs/sitekit-gap-closure/component-manifest.json',
  'docs/sitekit-gap-closure/token-manifest.json',
  'docs/sitekit-gap-closure/search-records.json',
  'dist',
  'tests/visual/component-snapshot.json',
];

function run(command, args) {
  execFileSync(command, args, { cwd: root, stdio: 'inherit' });
}

function filesUnder(target) {
  const absolute = path.join(root, target);
  if (!fs.existsSync(absolute)) return [];
  if (fs.statSync(absolute).isFile()) return [target];
  return fs.readdirSync(absolute, { withFileTypes: true }).flatMap((entry) => filesUnder(path.join(target, entry.name))).sort();
}

function digest() {
  const files = outputs.flatMap(filesUnder).sort();
  const sum = crypto.createHash('sha256');
  for (const file of files) sum.update(file).update('\0').update(fs.readFileSync(path.join(root, file))).update('\0');
  return sum.digest('hex');
}

run(process.execPath, ['scripts/build']);
run(process.execPath, ['scripts/snapshot-components']);
const first = digest();
run(process.execPath, ['scripts/build']);
run(process.execPath, ['scripts/snapshot-components']);
const second = digest();
if (first !== second) throw new Error(`generation is not deterministic: ${first} != ${second}`);
const changes = execFileSync('git', ['status', '--porcelain', '--untracked-files=all', '--ignored=matching', '--', ...outputs], { cwd: root, encoding: 'utf8' }).trim();
if (changes) throw new Error(`generated output differs from HEAD:\n${changes}`);
console.log(`generated output check passed: ${first}`);
