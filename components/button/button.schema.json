{
  "$schema": "../../schemas/component.schema.json",
  "name": "Button",
  "description": "A semantic action control for links, form submits, and interface commands.",
  "props": {
    "label": "string",
    "variant": "primary|secondary|ghost|danger",
    "href": "string optional",
    "type": "button|submit|reset",
    "disabled": "boolean",
    "loading": "boolean"
  },
  "variants": [
    "primary",
    "secondary",
    "ghost",
    "danger"
  ],
  "requiredFields": [
    "label"
  ],
  "accessibility": {
    "semantics": "Use native semantic elements in Button templates before ARIA.",
    "keyboard": "Interactive descendants must be reachable by keyboard and expose visible focus.",
    "focus": "Uses :focus-visible styles in component CSS.",
    "notes": [
      "Color is never the only communication channel.",
      "Motion must respect prefers-reduced-motion where animation exists."
    ]
  },
  "tokenDependencies": [
    "action.danger",
    "action.dangerText",
    "action.primary",
    "action.primaryText",
    "action.secondary",
    "action.secondaryText",
    "border.1",
    "border.strong",
    "component.button.gap",
    "component.button.height",
    "focus.offset",
    "focus.ring",
    "focus.width",
    "font.mono",
    "motion.ease",
    "motion.fast",
    "radius.0",
    "shadow.none",
    "space.4",
    "text.primary",
    "type.line.tight",
    "type.size.sm",
    "type.weight.bold"
  ],
  "responsive": {
    "strategy": "Intrinsic layout with logical properties, responsive grids, and container queries where useful.",
    "breakpoints": [
      "sm",
      "md",
      "lg"
    ]
  },
  "slots": [
    "label",
    "icon-start",
    "icon-end"
  ],
  "examples": [
    {
      "id": "button-default",
      "name": "Standalone",
      "props": {
        "label": "Button",
        "variant": "primary",
        "type": "button"
      },
      "htmlFile": "example.html",
      "notes": "Consumer-authored reference, no automatic prop binding. Prefix IDs before repeating."
    },
    {
      "id": "button-secondary",
      "name": "secondary",
      "props": {
        "label": "Button",
        "variant": "secondary",
        "type": "button"
      },
      "htmlFile": "example-secondary.html",
      "notes": "Consumer-authored reference, no automatic prop binding. Prefix IDs before repeating."
    },
    {
      "id": "button-ghost",
      "name": "ghost",
      "props": {
        "label": "Button",
        "variant": "ghost",
        "type": "button"
      },
      "htmlFile": "example-ghost.html",
      "notes": "Consumer-authored reference, no automatic prop binding. Prefix IDs before repeating."
    },
    {
      "id": "button-danger",
      "name": "danger",
      "props": {
        "label": "Button",
        "variant": "danger",
        "type": "button"
      },
      "htmlFile": "example-danger.html",
      "notes": "Consumer-authored reference, no automatic prop binding. Prefix IDs before repeating."
    }
  ],
  "allowedChildren": [
    "label",
    "icon-start",
    "icon-end"
  ],
  "propertyContracts": {
    "label": {
      "type": "string",
      "required": true,
      "default": null,
      "allowedValues": null,
      "binding": {
        "selector": ".sk-button",
        "html": "textContent; include icon-start/icon-end as children"
      },
      "stateOwner": "consumer",
      "example": "Button"
    },
    "variant": {
      "type": "string",
      "required": false,
      "default": null,
      "allowedValues": [
        "primary",
        "secondary",
        "ghost",
        "danger"
      ],
      "binding": {
        "selector": ".sk-button",
        "html": "see variantContracts; names do not imply data-variant support"
      },
      "stateOwner": "consumer",
      "example": "primary"
    },
    "href": {
      "type": "string",
      "required": false,
      "default": null,
      "allowedValues": null,
      "binding": {
        "selector": "a.sk-button",
        "html": "native href on an anchor, not a button"
      },
      "stateOwner": "consumer",
      "example": "Example"
    },
    "type": {
      "type": "string",
      "required": false,
      "default": "button",
      "allowedValues": [
        "button",
        "submit",
        "reset"
      ],
      "binding": {
        "selector": "button.sk-button",
        "html": "native type; default template button"
      },
      "stateOwner": "native",
      "example": "button"
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "default": null,
      "allowedValues": null,
      "binding": {
        "selector": "button, input, select, textarea",
        "html": "native disabled attribute"
      },
      "stateOwner": "native",
      "example": false
    },
    "loading": {
      "type": "boolean",
      "required": false,
      "default": null,
      "allowedValues": null,
      "binding": {
        "selector": "button.sk-button",
        "html": "consumer sets aria-busy=true, disabled and status; reference-compositions/index.html"
      },
      "stateOwner": "consumer",
      "example": false
    }
  },
  "variantContracts": {
    "primary": {
      "kind": "alias",
      "binding": null,
      "aliasOf": "base",
      "notes": "Compatible legacy name for the base appearance; no distinct attribute behavior."
    },
    "secondary": {
      "kind": "implemented",
      "binding": "[data-variant=\"secondary\"]",
      "aliasOf": null,
      "notes": "Apply the attribute on the source selector.",
      "example": "button-secondary"
    },
    "ghost": {
      "kind": "implemented",
      "binding": "[data-variant=\"ghost\"]",
      "aliasOf": null,
      "notes": "Apply the attribute on the source selector.",
      "example": "button-ghost"
    },
    "danger": {
      "kind": "implemented",
      "binding": "[data-variant=\"danger\"]",
      "aliasOf": null,
      "notes": "Apply the attribute on the source selector.",
      "example": "button-danger"
    }
  },
  "guidance": {
    "use": "Trigger an action using a native button, or style a navigation anchor.",
    "avoid": "A div acting as a button or an aria-disabled anchor assumed inert."
  },
  "slotContracts": {
    "label": {
      "owner": "consumer",
      "content": "Trusted authored semantic HTML; preserve child structure in example.html. Text data must be escaped.",
      "example": "example.html"
    },
    "icon-start": {
      "owner": "consumer",
      "content": "Trusted authored semantic HTML; preserve child structure in example.html. Text data must be escaped.",
      "example": "example.html"
    },
    "icon-end": {
      "owner": "consumer",
      "content": "Trusted authored semantic HTML; preserve child structure in example.html. Text data must be escaped.",
      "example": "example.html"
    }
  },
  "historicalSources": [
    [
      "old-components/testing-buttons.html"
    ]
  ],
  "category": "Actions"
}
